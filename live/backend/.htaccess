<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to database directory, .json, .env, and sensitive files
    RewriteRule ^database/ - [F,L]
    RewriteRule \.(json|env|sql|log)$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Direct file protection fallback
<FilesMatch "\.(json|env|sql|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
